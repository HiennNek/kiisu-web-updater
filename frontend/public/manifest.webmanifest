{
    "name": "Kiisu web updater",
    "short_name": "Kiisu web updater",
    "display": "standalone",
    "start_url": "/",
    "background_color": "#fff",
    "theme_color": "#7c3aed",
    "lang": "en",
    "orientation": "any",
    "description": "Kiisu is a fanatic's portable multi-tool in a card-sized form. This app helps you manage your device data, organize your keys and share it with other Kiisu users",
    "categories": [
        "developer tools",
        "developer",
        "development",
        "utilities"
    ],
    "launch_handler": {
        "client_mode": ["focus-existing", "auto"]
    },
    "shortcuts": [
        {
            "name": "Files",
            "url": "/archive"
        },
        {
            "name": "Cli",
            "url": "/cli"
        }
    ],
    "icons": [
        {
            "src": "/icons/icon-192.png",
            "type": "image/png",
            "sizes": "192x192"
        },
        {
            "src": "/icons/icon-512.png",
            "type": "image/png",
            "sizes": "512x512"
        }
    ],
    "screenshots": [
        {
            "src": "/screenshots/screenshot1.png",
            "type": "image/png",
            "sizes": "540x720",
            "form_factor": "narrow",
            "label": "View informations and update your Kiisu"
        },
        {
            "src": "/screenshots/screenshot3.jpg",
            "type": "image/jpeg",
            "sizes": "540x720",
            "form_factor": "narrow",
            "label": "Explore and upload files on your device"
        },
        {
            "src": "/screenshots/screenshot4.png",
            "type": "image/jpeg",
            "sizes": "1024x593",
            "form_factor": "wide",
            "label": "View informations and update your Kiisu"
        },
        {
            "src": "/screenshots/screenshot6.jpg",
            "type": "image/jpeg",
            "sizes": "1024x593",
            "form_factor": "wide",
            "label": "Explore and upload files on your device"
        }
    ]
}
